<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMU_Revamp.ViewModels"
             xmlns:views="using:SMU_Revamp.Views"
             x:Class="SMU_Revamp.Views.Controls.ResultSubCellsControl"
             x:DataType="vm:MainWindowViewModel">
    <Border Background="#FFFFFF" BoxShadow="0 4 15 0 #15000000" CornerRadius="8" Padding="14,16" Margin="0,0,15,0" Width="230" VerticalAlignment="Top">
        <StackPanel Spacing="16">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Sub-Cells" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" ToolTip.Tip="Use Arrow Keys (↑ / ↓ / ← / →) to navigate Sub-Cell Rows and Columns">
                        <TextBlock Text="↑↓←→" FontSize="10" FontWeight="SemiBold" Foreground="#4B5563" />
                    </Border>
                </Grid>
                <TextBlock Text="Select a cell on the left first." IsVisible="{Binding SelectedResultCell, Converter={x:Static ObjectConverters.IsNull}}" FontStyle="Italic" Foreground="Gray" TextWrapping="Wrap" />
                
                <Viewbox Stretch="Uniform" HorizontalAlignment="Center" StretchDirection="DownOnly" MaxWidth="202" IsVisible="{Binding SelectedResultCell, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Border Background="#F3F4F6" Padding="6" CornerRadius="6">
                        <ItemsControl ItemsSource="{Binding SelectedResultCell.SubCells}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" Rows="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ResultSubCellViewModel">
                                    <Border Width="35" Height="35" Margin="1.5" Background="{Binding Color}" CornerRadius="4" IsVisible="{Binding IsValid}" Classes.selected="{Binding IsSelected}">
                                        <Border.Styles>
                                            <Style Selector="Border.selected">
                                                <Setter Property="BorderBrush" Value="#1F2937" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </Style>
                                        </Border.Styles>
                                        <ToolTip.Tip>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" />
                                                <TextBlock Text="{Binding FormattedValue}" />
                                                <TextBlock Text="{Binding MetricLabel}" IsVisible="{Binding MetricLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontStyle="Italic" Foreground="Gray" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <Grid>
                                            <RadioButton GroupName="ResultSubCells"
                                                         Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SetSelectedResultSubCellCommand}"
                                                         CommandParameter="{Binding}"
                                                         Opacity="0"
                                                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
                                            <TextBlock Text="{Binding Id}" FontSize="10" FontWeight="Bold" Foreground="{Binding Color, Converter={x:Static views:BrushToContrastForegroundConverter.Instance}}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </Viewbox>
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding SelectedResultSubCell, Converter={x:Static ObjectConverters.IsNotNull}}">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Contacts" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <Border Grid.Column="1" Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="4" Padding="5,2" VerticalAlignment="Center" ToolTip.Tip="Use Alt + Arrow Keys (↑ / ↓) to navigate between Contacts">
                        <TextBlock Text="Alt + ↑↓" FontSize="10" FontWeight="SemiBold" Foreground="#4B5563" />
                    </Border>
                </Grid>
                <ListBox ItemsSource="{Binding SelectedResultSubCell.Contacts}"
                         SelectedItem="{Binding SelectedResultContact}"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResultContactViewModel">
                            <Border Background="{Binding Color}" CornerRadius="4" Padding="8,5" Margin="0,2">
                                <ToolTip.Tip>
                                    <StackPanel>
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" />
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectedResultMetric}" FontWeight="SemiBold"/>
                                            <TextBlock Text=":"/>
                                            <TextBlock Text="{Binding FormattedValue}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding MetricLabel}" IsVisible="{Binding MetricLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" FontStyle="Italic" Foreground="Gray" />
                                    </StackPanel>
                                </ToolTip.Tip>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0" Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding Color, Converter={x:Static views:BrushToContrastForegroundConverter.Instance}}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding FormattedValue}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Color, Converter={x:Static views:BrushToContrastForegroundConverter.Instance}}" VerticalAlignment="Center" Margin="4,0,0,0" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
