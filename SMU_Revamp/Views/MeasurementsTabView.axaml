<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:SMU_Revamp.ViewModels"
             xmlns:views="using:SMU_Revamp.Views"
             xmlns:models="using:SMU_Revamp.Models"
             xmlns:controls="using:SMU_Revamp.Views.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SMU_Revamp.Views.MeasurementsTabView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="*, Auto" Margin="20">
        <Grid Grid.Row="0">
            <Grid ColumnDefinitions="55*, 45*" RowDefinitions="Auto, *" Margin="10">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Measurement Configuration" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Measurement Status &amp; Diagnostics" FontSize="18" FontWeight="SemiBold" Margin="20,0,0,0" />
                
                <!-- Left Column: Configuration -->
                <ScrollViewer Grid.Row="1" Grid.Column="0" x:Name="MeasurementScrollViewer" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden" ScrollChanged="MeasurementScrollViewer_ScrollChanged">
                    <Border Background="#FFFFFF" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Padding="20" Margin="10,15,10,20" BoxShadow="0 4 15 0 #15000000">
                        <StackPanel Spacing="10" MaxWidth="800" IsEnabled="{Binding !IsScanningWafer}">
                            <WrapPanel Orientation="Horizontal" Margin="0,5,0,0" VerticalAlignment="Center">
                                <TextBlock Text="Preset:" Width="150" VerticalAlignment="Center" Margin="0,0,10,10" />
                                <ComboBox ItemsSource="{Binding AvailablePresets}"
                                          SelectedItem="{Binding SelectedPreset}"
                                          PlaceholderText="No presets saved"
                                          Width="150" Height="32" VerticalAlignment="Center" Margin="0,0,10,10">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                
                                <StackPanel Orientation="Vertical" VerticalAlignment="Center" Margin="0,0,10,10">
                                    <TextBox Text="{Binding NewPresetName}" PlaceholderText="Preset Name" Width="120" Height="32" VerticalContentAlignment="Center">
                                        <TextBox.Styles>
                                            <Style Selector="TextBox.invalid /template/ Border#PART_BorderElement">
                                                <Setter Property="BorderBrush" Value="#EF4444"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                            </Style>
                                        </TextBox.Styles>
                                        <Classes.invalid>
                                            <MultiBinding Converter="{x:Static BoolConverters.Or}">
                                                <Binding Path="IsPresetNameInvalid" />
                                            </MultiBinding>
                                        </Classes.invalid>
                                    </TextBox>
                                </StackPanel>
                                <Button Content="Save" Command="{Binding SavePresetCommand}" Classes="Primary" Height="32" VerticalContentAlignment="Center" VerticalAlignment="Center" Margin="0,0,10,10" />
                                <Button Content="Delete" Command="{Binding DeletePresetCommand}" Classes="Danger" Height="32" VerticalContentAlignment="Center" IsEnabled="{Binding SelectedPreset, Converter={x:Static ObjectConverters.IsNotNull}}" VerticalAlignment="Center" Margin="0,0,15,10" />

                                <!-- Single Measurement Duration Display -->
                                <Border Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="6" Padding="10,0" Height="32" VerticalAlignment="Center" Margin="0,0,10,10">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Path Fill="#6B7280" Data="M12 2C6.5 2 2 6.5 2 12s4.5 10 10 10 10-4.5 10-10S17.5 2 12 2zm4.2 14.2L11 13V7h1.5v5.2l4.5 2.7-.8 1.3z" Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                        <TextBlock Text="Duration:" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding SingleMeasurementDurationText}" FontSize="12" FontWeight="Bold" Foreground="#1F2937" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                            
                            <!-- Overwrite Confirmation popup inline -->
                            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,5,0,0" IsVisible="{Binding IsOverwriteWarningVisible}">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Fill="#EF4444" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,5"/>
                                    <TextBlock Text="Preset already exists. Overwrite?" Foreground="#B91C1C" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,5"/>
                                    <Button Content="Yes" Command="{Binding ConfirmSavePresetCommand}" Classes="Primary" Padding="10,3" Margin="0,0,10,5" />
                                    <Button Content="No" Command="{Binding CancelSavePresetCommand}" Classes="Secondary" Padding="10,3" Margin="0,0,0,5" />
                                </WrapPanel>
                            </Border>

                            <!-- Delete Confirmation popup inline -->
                            <Border Background="#FEE2E2" BorderBrush="#EF4444" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,5,0,0" IsVisible="{Binding IsDeleteWarningVisible}">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Fill="#EF4444" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,10,5"/>
                                    <TextBlock Text="Are you sure you want to delete this preset?" Foreground="#B91C1C" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,5" />
                                    <Button Content="Yes" Command="{Binding ConfirmDeletePresetCommand}" Classes="Danger" Padding="10,3" Margin="0,0,10,5" />
                                    <Button Content="No" Command="{Binding CancelDeletePresetCommand}" Classes="Secondary" Padding="10,3" Margin="0,0,0,5" />
                                </WrapPanel>
                            </Border>

                            <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Measurement Plan:" Width="150" VerticalAlignment="Center" Margin="0,0,10,10" />
                                <ComboBox ItemsSource="{Binding MeasurementPlans}"
                                          SelectedItem="{Binding SelectedPlan}"
                                          Width="200">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </WrapPanel>

                            <Separator Margin="0,15,0,15" Background="#E5E7EB" Height="1" />

                            <TextBlock Text="{Binding SelectedPlan.Description}" 
                                       TextWrapping="Wrap" 
                                       FontStyle="Italic" 
                                       Opacity="0.7" 
                                       Margin="0,5,0,15" />

                            <!-- Sequencer UI Panel -->
                            <controls:SequenceEditorControl />

                            <controls:ParameterEditorControl />

                            <!-- Expandable Target Contact Navigation -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Margin="0,15,0,5">
                                <Expander Header="Target Contact Navigation (Go to Contact)" IsExpanded="False" HorizontalAlignment="Stretch" CornerRadius="8" Background="Transparent" BorderThickness="0">
                                    <StackPanel Spacing="10" Margin="5,0,5,5">
                                        <TextBlock Text="Specify target contact to move the prober and connect matrix routing:" FontSize="12" Foreground="#666666" TextWrapping="Wrap" />
                                        <Grid ColumnDefinitions="*,*,*,*" Margin="0,5,0,5">
                                            <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,6,0">
                                                <TextBlock Text="Cell (YYXX)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" />
                                                <TextBox Text="{Binding TargetCell}" PlaceholderText="e.g. 0101" Height="32" VerticalContentAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="2" Margin="0,0,6,0">
                                                <TextBlock Text="Row (1-5)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" />
                                                <TextBox Text="{Binding TargetRow}" PlaceholderText="1-5" Height="32" VerticalContentAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Spacing="2" Margin="0,0,6,0">
                                                <TextBlock Text="Col (1-5)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" />
                                                <TextBox Text="{Binding TargetColumn}" PlaceholderText="1-5" Height="32" VerticalContentAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="3" Spacing="2">
                                                <TextBlock Text="Contact (1-6)" FontSize="11" FontWeight="SemiBold" Foreground="#374151" />
                                                <TextBox Text="{Binding TargetContact}" PlaceholderText="1-6" Height="32" VerticalContentAlignment="Center" FontSize="12" />
                                            </StackPanel>
                                        </Grid>
                                        
                                        <CheckBox Content="Connect chuck after move" IsChecked="{Binding ConnectChuckAfterMove}" Margin="0,2,0,8" />

                                        <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Go to Contact" Command="{Binding GoToContactCommand}" Classes="Primary" Height="34" VerticalContentAlignment="Center" VerticalAlignment="Center" Padding="16,0" Margin="0,0,10,0" />
                                            <Button Content="Go Home" Command="{Binding GoHomeCommand}" Classes="Secondary" Height="34" VerticalContentAlignment="Center" VerticalAlignment="Center" Padding="16,0" Margin="0,0,10,0" />
                                            <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="400" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Expander>
                            </Border>

                            <CheckBox Content="Switch to Viewer tab automatically"
                                      IsChecked="{Binding AutoSwitchToViewer}"
                                      Margin="0,10,0,0" />

                            <CheckBox Content="Automatically save measurements"
                                      IsChecked="{Binding AutoSaveMeasurements}"
                                      Margin="0,5,0,0" />
                                      
                            <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,20,0,0">
                                <Button Content="Run Measurement" 
                                        Command="{Binding RunMeasurementCommand}" 
                                        IsEnabled="{Binding !IsMeasuring}"
                                        Classes="Primary" 
                                        Width="180" />

                                <Button Content="Export to CSV" 
                                        Click="ExportCsvButton_Click"
                                        IsEnabled="{Binding HasCurvePoints}"
                                        Classes="Secondary" 
                                        Width="150" />
                            </StackPanel>

                            <!-- Experiment Queue -->
                            <Border Background="#F9FAFB" BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Margin="0,15,0,5">
                                <Expander Header="Experiment Queue" IsExpanded="False" HorizontalAlignment="Stretch" CornerRadius="8" Background="Transparent" BorderThickness="0">
                                    <Expander.Styles>
                                        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Background" Value="Transparent" />
                                        </Style>
                                    </Expander.Styles>
                                    <StackPanel Spacing="10" Margin="5,5,5,5">

                                        <TextBlock Text="Chain saved presets into an automatic experiment series. Pauses between programs let the device settle."
                                                   FontSize="12" Foreground="#666666" TextWrapping="Wrap" />

                                        <StackPanel Orientation="Horizontal" Spacing="10" IsEnabled="{Binding !IsQueueRunning}">
                                            <Button Content="+ Add selected preset" Command="{Binding AddSelectedPresetToQueueCommand}" Classes="Secondary" Padding="12,6" />
                                            <TextBox Text="{Binding QueuePauseMinutes}" PlaceholderText="Pause (min)" Width="90" Height="32" VerticalContentAlignment="Center" />
                                            <Button Content="+ Add pause" Command="{Binding AddQueuePauseCommand}" Classes="Secondary" Padding="12,6" />
                                        </StackPanel>

                                        <ListBox ItemsSource="{Binding MeasurementQueue}"
                                                 SelectedItem="{Binding SelectedQueueItem}"
                                                 Height="170">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Padding" Value="6,2" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:QueueItemViewModel">
                                                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="2,0">
                                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Status}" VerticalAlignment="Center" Margin="10,0,0,0" FontWeight="SemiBold"
                                                                   Classes.running="{Binding IsRunning}"
                                                                   Classes.done="{Binding IsDone}"
                                                                   Classes.failed="{Binding IsFailed}">
                                                            <TextBlock.Styles>
                                                                <Style Selector="TextBlock">
                                                                    <Setter Property="Foreground" Value="#6B7280" />
                                                                </Style>
                                                                <Style Selector="TextBlock.running">
                                                                    <Setter Property="Foreground" Value="#2563EB" />
                                                                </Style>
                                                                <Style Selector="TextBlock.done">
                                                                    <Setter Property="Foreground" Value="#16A34A" />
                                                                </Style>
                                                                <Style Selector="TextBlock.failed">
                                                                    <Setter Property="Foreground" Value="#DC2626" />
                                                                </Style>
                                                            </TextBlock.Styles>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="2" Text="{Binding Type}" VerticalAlignment="Center" Margin="12,0,0,0" FontSize="11" Foreground="#9CA3AF" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>

                                        <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsQueueRunning}">
                                            <Button Content="↑ Up" Command="{Binding MoveQueueItemUpCommand}" Classes="Secondary" Padding="10,4" />
                                            <Button Content="↓ Down" Command="{Binding MoveQueueItemDownCommand}" Classes="Secondary" Padding="10,4" />
                                            <Button Content="Remove" Command="{Binding RemoveQueueItemCommand}" Classes="Secondary" Padding="10,4" />
                                            <Button Content="Clear All" Command="{Binding ClearQueueCommand}" Classes="Secondary" Padding="10,4" />
                                        </StackPanel>

                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <Button Content="Start Queue" Command="{Binding StartQueueCommand}" Classes="Primary" Padding="16,6" />
                                            <Button Content="Stop Queue" Command="{Binding StopQueueCommand}" Classes="Danger" Padding="16,6"
                                                    IsEnabled="{Binding IsQueueRunning}" />
                                        </StackPanel>

                                        <TextBlock Text="{Binding QueueStatusText}" FontSize="12" Foreground="#374151" TextWrapping="Wrap"
                                                   IsVisible="{Binding QueueStatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                </Expander>
                            </Border>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Right Column: Status -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="20,15,10,20" RowDefinitions="Auto, *">
                    <Border Grid.Row="0" CornerRadius="8" BoxShadow="0 4 15 0 #15000000" Margin="0,0,0,15" Background="#FFFFFF" BorderBrush="Transparent" BorderThickness="0">
                        <Expander Header="Measurement Status &amp; Diagnostics" IsExpanded="False" HorizontalAlignment="Stretch" CornerRadius="8" Background="Transparent" BorderThickness="0" BorderBrush="Transparent">
                            <Expander.Styles>
                                <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Background" Value="Transparent" />
                                </Style>
                            </Expander.Styles>
                            <StackPanel Spacing="10" Margin="15,0,15,15">
                                <Border BorderBrush="Transparent" BorderThickness="0" CornerRadius="4" Padding="15" Background="#F9F9F9" MinWidth="450" MinHeight="80">
                                    <TextBlock Text="{Binding MeasurementStatus}" 
                                               Foreground="#333333"
                                               FontFamily="Courier New" 
                                               FontSize="12" 
                                               TextWrapping="Wrap" />
                                </Border>

                                <StackPanel Spacing="5" IsVisible="{Binding IsMeasuringSweep}">
                                    <Grid ColumnDefinitions="*, Auto">
                                        <TextBlock Text="Measurement Progress" FontSize="11" FontWeight="SemiBold" Foreground="#666666" />
                                        <TextBlock Grid.Column="1" Text="{Binding MeasurementProgressText}" FontSize="11" FontWeight="SemiBold" Foreground="#333333" />
                                    </Grid>
                                    <ProgressBar Minimum="0" 
                                                 Maximum="100" 
                                                 Value="{Binding MeasurementProgress}" 
                                                 IsIndeterminate="{Binding IsProgressIndeterminate}" 
                                                 Height="8" 
                                                 CornerRadius="4"
                                                 Foreground="#3B82F6"
                                                 Background="#E0E0E0" />
                                </StackPanel>

                                <TextBlock Text="{Binding WarningMessage}" 
                                           Foreground="#E65100" 
                                           TextWrapping="Wrap" 
                                           HorizontalAlignment="Stretch"
                                           IsVisible="{Binding HasWarningMessage}" />

                                <TextBlock Text="{Binding ErrorMessage}" 
                                           Foreground="#D32F2F" 
                                           TextWrapping="Wrap" 
                                           HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Expander>
                    </Border>

                    <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="Transparent" BorderThickness="0" CornerRadius="8" Padding="20" BoxShadow="0 4 15 0 #15000000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid RowDefinitions="*, Auto">
                            <views:CurvePlotView Grid.Row="0" Title="Live Measurement Preview"
                                                 XAxisLabel="{Binding XAxisTitle}"
                                                 YAxisLabel="{Binding YAxisTitle}"
                                                 Series="{Binding PlotSeries}"
                                                 Points="{Binding CurvePoints}"
                                                 PlotStyle="{Binding SelectedPlotStyle}"
                                                 LogarithmicY="{Binding IsMeasurementLogarithmic}"
                                                 LogarithmicX="{Binding IsMeasurementLogarithmicX}"
                                                 PlotAspectRatio="{Binding PlotAspectRatio}"
                                             SeriesSettings="{Binding SeriesSettings}" />
                            
                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="20" Margin="0,15,0,0" HorizontalAlignment="Center">
                                <CheckBox Content="Logarithmic X-Axis" IsChecked="{Binding IsMeasurementLogarithmicX}" />
                                <CheckBox Content="Logarithmic Y-Axis" IsChecked="{Binding IsMeasurementLogarithmic}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- Scroll Indicator -->
            <Border x:Name="MeasurementScrollIndicator" 
                    VerticalAlignment="Bottom" 
                    Height="30" 
                    IsHitTestVisible="False"
                    Opacity="0">
                <Border.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.2"/>
                    </Transitions>
                </Border.Transitions>
                <Path Data="M0,0 L6,6 L12,0" 
                      Stroke="#888888" 
                      StrokeThickness="2" 
                      Fill="Transparent" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Bottom" 
                      Margin="0,0,0,10"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>
