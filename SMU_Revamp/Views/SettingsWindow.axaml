<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:SMU_Revamp.ViewModels"
        mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
        x:Class="SMU_Revamp.Views.SettingsWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/smu_logo.png"
        Title="Settings"
        WindowStartupLocation="CenterOwner"
        Width="700"
        Height="700">

    <Window.Styles>
        <Style Selector="TabItem.MainTab:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="Background" Value="Black" />
        </Style>
    </Window.Styles>

    <Grid>
        <TabControl Margin="10">
            <!-- Configuration Tab -->
            <TabItem Header="Configuration" Classes="MainTab">
                <ScrollViewer Margin="10" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="20">
                        <WrapPanel Orientation="Horizontal">
                            <!-- Target Contact -->
                            <StackPanel Spacing="10" Margin="10,0,40,20" Width="300">
                                <TextBlock Text="Target Contact" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Cell:" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding TargetCell}" PlaceholderText="e.g. 0101" Width="150" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Row:" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding TargetRow}" PlaceholderText="e.g. 1" Width="150" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Column:" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding TargetColumn}" PlaceholderText="e.g. 1" Width="150" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Contact:" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding TargetContact}" PlaceholderText="e.g. 1" Width="150" />
                                </StackPanel>
                                <Button Content="Go To Contact" Command="{Binding GoToTargetContactCommand}" Classes="Primary" Width="150" Margin="0,10,0,0" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="#D32F2F" TextWrapping="Wrap" MaxWidth="300" HorizontalAlignment="Left" />
                            </StackPanel>

                            <!-- Manual Move -->
                            <StackPanel Spacing="10" Margin="10,0,40,20" Width="330">
                                <TextBlock Text="Manual Move" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,5" />
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="X Position:" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding MoveX}" PlaceholderText="e.g. 100" Width="100" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Y Position:" Width="120" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding MoveY}" PlaceholderText="e.g. 100" Width="100" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                    <Button Content="Move Relative" Command="{Binding MoveRelativeCommand}" Classes="Secondary" Width="150" />
                                    <Button Content="Move Absolute" Command="{Binding MoveAbsoluteCommand}" Classes="Secondary" Width="150" />
                                </StackPanel>
                            </StackPanel>

                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Debug Tab -->
            <TabItem Header="Debug" Classes="MainTab">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Orientation="Vertical" Margin="10" Spacing="20">
                        <StackPanel Spacing="5">
                            <TextBlock Text="Device Connection Debugger" FontSize="18" FontWeight="Bold" />
                            <TextBlock Text="Test VISA connectivity to Prober, Switch Matrix, and SMU devices" FontSize="12" Foreground="#666666" />
                        </StackPanel>

                        <!-- Prober Card -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Background="#F9FAFB">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Prober (GPIB0::22::INSTR)" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Test Connection" Click="TestProberConnection_Click" Classes="Primary" Padding="15,8" />
                                </StackPanel>
                                
                                <StackPanel Spacing="6">
                                    <TextBlock Text="Output:" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" />
                                    <TextBox x:Name="ProberOutputTextBox" IsReadOnly="True" Height="80" Padding="10" Text="Ready..." FontFamily="Courier New" FontSize="10" AcceptsReturn="True" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Switch Matrix Card -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Background="#F9FAFB">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Switch Matrix (GPIB0::23::INSTR)" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Test Connection" Click="TestSwitchConnection_Click" Classes="Primary" Padding="15,8" />
                                    <Button Content="Clear All" Click="ClearAllSwitchConnections_Click" Classes="Secondary" Padding="15,8" />
                                </StackPanel>

                                <Separator Margin="0,4" />

                                <!-- Manual Connection Control -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Manual Connection Control:" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" />
                                    
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,10">
                                            <TextBlock Text="Input (1-10):" VerticalAlignment="Center" />
                                            <TextBox x:Name="ConnectionXTextBox" PlaceholderText="e.g. 05" Width="90" />
                                        </StackPanel>
                                        
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,16,10">
                                            <TextBlock Text="Output (1-12):" VerticalAlignment="Center" />
                                            <TextBox x:Name="ConnectionYTextBox" PlaceholderText="e.g. 01" Width="90" />
                                        </StackPanel>
                                        
                                        <Button Content="Create Connection" Click="CreateSwitchConnection_Click" Classes="Secondary" Padding="15,8" Margin="0,0,8,10" />
                                        <Button Content="Disconnect Route" Click="DisconnectSwitchConnection_Click" Classes="Secondary" Padding="15,8" Margin="0,0,0,10" />
                                    </WrapPanel>
                                    
                                    <TextBlock Text="Note: HP E5250A channel format is Card (1) + Input Port (2 digits) + Output Port (2 digits), e.g. 10501" FontSize="11" Foreground="#6B7280" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Output:" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" />
                                    <TextBox x:Name="SwitchOutputTextBox" IsReadOnly="True" Height="80" Padding="10" Text="Ready..." FontFamily="Courier New" FontSize="10" AcceptsReturn="True" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- SMU Card -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Background="#F9FAFB">
                            <StackPanel Spacing="12">
                                <TextBlock Text="SMU (GPIB0::17::INSTR)" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" />
                                
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Test Connection" Click="TestSMUConnection_Click" Classes="Primary" Padding="15,8" />
                                    <Button Content="Query Identity" Click="QuerySMUIdentity_Click" Classes="Secondary" Padding="15,8" />
                                </StackPanel>

                                <Separator Margin="0,4" />

                                <!-- Force Voltage Control -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Force Voltage &amp; Compliance Test Control:" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" />
                                    
                                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Write / Force Channel -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,10">
                                            <TextBlock Text="Force Ch:" VerticalAlignment="Center" />
                                            <TextBox x:Name="SmuChannelTextBox" Text="2" PlaceholderText="2" Width="45" />
                                        </StackPanel>

                                        <!-- Reading / Return Channel -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,10">
                                            <TextBlock Text="Return Ch:" VerticalAlignment="Center" />
                                            <TextBox x:Name="SmuReturnChannelTextBox" Text="1" PlaceholderText="1" Width="45" />
                                        </StackPanel>
                                        
                                        <!-- Voltage -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,10">
                                            <TextBlock Text="Volt (V):" VerticalAlignment="Center" />
                                            <TextBox x:Name="SmuVoltageTextBox" Text="1.0" PlaceholderText="1.0" Width="65" />
                                        </StackPanel>
                                        
                                        <!-- Compliance -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,10">
                                            <TextBlock Text="Comp (A):" VerticalAlignment="Center" />
                                            <TextBox x:Name="SmuComplianceTextBox" Text="0.01" PlaceholderText="0.01" Width="70" />
                                        </StackPanel>
                                        
                                        <!-- Duration -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,0,12,10">
                                            <TextBlock Text="Dur (s):" VerticalAlignment="Center" />
                                            <TextBox x:Name="SmuDurationTextBox" Text="5" PlaceholderText="5" Width="45" />
                                        </StackPanel>
                                        
                                        <!-- Force Voltage Button -->
                                        <Button Content="Force &amp; Check Compliance" Click="ForceSmuVoltage_Click" Classes="Secondary" Padding="14,8" Margin="0,0,0,10" />
                                    </WrapPanel>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="Output &amp; Live Compliance Check:" FontSize="12" FontWeight="SemiBold" Foreground="#4B5563" />
                                    <TextBox x:Name="SmuOutputTextBox" IsReadOnly="True" Height="110" Padding="10" Text="Ready..." FontFamily="Courier New" FontSize="11" AcceptsReturn="True" TextWrapping="Wrap" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Global Progress Bar Demo Card -->
                        <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="16" Background="#F9FAFB">
                            <StackPanel Spacing="12">
                                <TextBlock Text="Global Progress Bar Demo" FontSize="14" FontWeight="SemiBold" Foreground="#1F2937" />
                                <TextBlock Text="Test the visual appearance, pulsing animations, and layout of the top global progress bar." FontSize="12" Foreground="#666666" TextWrapping="Wrap" />
                                
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Play Demo Progress (10s)" Click="PlayProgressDemo_Click" Classes="Primary" Padding="15,8" Margin="0,0,10,0" />
                                    <Button Content="Toggle Indeterminate Demo" Click="ToggleIndeterminateDemo_Click" Classes="Secondary" Padding="15,8" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Developer" Classes="MainTab">
<ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Vertical" Margin="20" Spacing="15">
            <!-- Warning Disclaimer Box -->
            <Border Background="#FEEBEE" BorderBrush="#EF5350" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,5">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="⚠️" FontSize="20" VerticalAlignment="Center" />
                    <TextBlock Text="Warning: Modifying connection settings, GPIB resources, or timeouts can lead to severe communication issues, device timeouts, or unexpected hardware state changes. Adjust these parameters with caution."
                               Foreground="#C62828"
                               FontSize="12"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Width="480" />
                </StackPanel>
            </Border>

            <!-- Prober Section -->
            <TextBlock Text="Prober / Stager" FontSize="16" FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Quiet Mode:" Width="120" VerticalAlignment="Center" />
                    <CheckBox IsChecked="{Binding Settings.ProberQuietMode}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Resource:" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Settings.ProberResource}" Width="160" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Timeout (ms):" Width="120" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Settings.ProberTimeoutMs}" Minimum="1000" Maximum="60000" Increment="1000" ShowButtonSpinner="False" Width="160" />
                </StackPanel>
            </StackPanel>

            <!-- Separator -->
            <Separator Margin="0,10" />

            <!-- Switch Matrix Section -->
            <TextBlock Text="Switch Matrix" FontSize="16" FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Resource:" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Settings.SwitchMatrixResource}" Width="160" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Timeout (ms):" Width="120" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Settings.SwitchMatrixTimeoutMs}" Minimum="1000" Maximum="60000" Increment="1000" ShowButtonSpinner="False" Width="160" />
                </StackPanel>
            </StackPanel>

            <!-- Separator -->
            <Separator Margin="0,10" />

            <!-- Simulation Section -->
            <TextBlock Text="Simulation" FontSize="16" FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10" Margin="20,0,0,0">
                <CheckBox IsChecked="{Binding Settings.SimulationMode}" Content="Simulation mode (no hardware required)" />
                <TextBlock Text="Simulates SMU, prober, and switch matrix in software. Measurements generate plausible synthetic data; disconnect/reconnect devices after changing this setting."
                           FontSize="11" Foreground="#888888" TextWrapping="Wrap" MaxWidth="420" />
            </StackPanel>

            <!-- E5263 SMU Section -->
            <TextBlock Text="E5263 SMU" FontSize="16" FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Resource:" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Settings.SMUResource}" Width="160" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Timeout (ms):" Width="120" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Settings.SMUTimeoutMs}" Minimum="1000" Maximum="600000" Increment="5000" ShowButtonSpinner="False" Width="160" />
                </StackPanel>
            </StackPanel>

            <!-- Separator -->
            <Separator Margin="0,10" />

            <!-- Wafermap Scan Section -->
            <TextBlock Text="Wafermap Scan &amp; Live Plot" FontSize="16" FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Max Plot Curves:" Width="140" VerticalAlignment="Center" />
                    <NumericUpDown Value="{Binding Settings.WaferScanMaxPlotSeries}" Minimum="1" Maximum="100" Increment="1" ShowButtonSpinner="True" Width="160" />
                </StackPanel>
                <TextBlock Text="Number of recent curve series retained and displayed in the live plot during a wafer scan. Smaller values reduce UI lag during long scans (default: 10)."
                           FontSize="11" Foreground="#888888" TextWrapping="Wrap" MaxWidth="460" />
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Alignment Warning:" Width="140" VerticalAlignment="Center" />
                    <CheckBox IsChecked="{Binding Settings.ShowAlignmentWarning}" Content="Show alignment warning before scan starts" />
                </StackPanel>
            </StackPanel>

            <!-- Separator -->
            <Separator Margin="0,10" />

            <!-- Database Section -->
            <TextBlock Text="MySQL Database" FontSize="16" FontWeight="Bold" />

            <StackPanel Orientation="Vertical" Spacing="10" Margin="20,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Save to Database:" Width="120" VerticalAlignment="Center" />
                    <CheckBox IsChecked="{Binding Settings.SaveToDatabase}" Content="Save every measurement immediately" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Auto-Sync:" Width="120" VerticalAlignment="Center" />
                    <CheckBox IsChecked="{Binding Settings.AutoSyncDatabase}" Content="Synchronize missing data daily and on startup" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Address:" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Settings.DbAddress}" Width="200" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Username:" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Settings.DbUser}" Width="200" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Password:" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Settings.DbPassword}" Width="200" PasswordChar="*" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Database Name:" Width="120" VerticalAlignment="Center" />
                    <TextBox Text="{Binding Settings.DbName}" Width="200" />
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="130,5,0,0">
                    <Button Content="Test Connection" Click="TestDbConnectionButton_Click" IsEnabled="{Binding !Settings.IsSyncingDatabase}" />
                    <Button Content="Sync Database Now" Click="SyncDbNowButton_Click" Classes="Secondary" IsEnabled="{Binding !Settings.IsSyncingDatabase}" />
                </StackPanel>

                <!-- Immediate Test Connection Result -->
                <TextBlock Text="{Binding Settings.DbConnectionTestMessage}"
                           Foreground="{Binding Settings.DbConnectionTestForeground}"
                           FontSize="11"
                           FontWeight="Medium"
                           Margin="130,4,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           IsVisible="{Binding Settings.DbConnectionTestMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <TextBlock Text="{Binding Settings.SyncStatusMessage}"
                           Foreground="#4B5563"
                           FontSize="12"
                           Margin="130,4,0,0"
                           TextWrapping="Wrap"
                           MaxWidth="380" />
                <ProgressBar Minimum="0"
                             Maximum="100"
                             Value="{Binding Settings.SyncProgressPercentage}"
                             IsIndeterminate="{Binding Settings.IsSyncProgressIndeterminate}" 
                             IsVisible="{Binding Settings.IsSyncingDatabase}" 
                             Height="6" 
                             CornerRadius="3"
                             Margin="130,4,0,0" 
                             Width="250" 
                             HorizontalAlignment="Left" />

                <!-- Local Storage, Directories & Cleanup Card -->
                <Border BorderBrush="#E5E7EB" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,10,0,0" Background="#F9FAFB">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Local Storage &amp; Cleanup" FontSize="13" FontWeight="SemiBold" Foreground="#1F2937" />

                        <TextBlock Text="Configure storage locations for measurement files and application logs, monitor disk space, and manage cleanup of synced measurements."
                                   FontSize="11" Foreground="#6B7280" TextWrapping="Wrap" />

                        <!-- Storage Directories -->
                        <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto" Margin="0,2,0,0">
                            <!-- Measurements Directory -->
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Measurements / Sync:" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,6,0" />
                            <TextBox Grid.Column="1" Grid.Row="0" 
                                     Text="{Binding Settings.MeasurementsDirectory}" 
                                     PlaceholderText="{Binding Settings.DefaultMeasurementsDirectory}" 
                                     Height="32" VerticalContentAlignment="Center" 
                                     Margin="0,0,8,0" />
                            <Button Grid.Column="2" Grid.Row="0" Content="Browse..." 
                                    Click="BrowseMeasurementsDirectory_Click" 
                                    Classes="Secondary" Height="32" Padding="12,0" 
                                    VerticalContentAlignment="Center" />

                            <!-- Logs Directory -->
                            <TextBlock Grid.Column="0" Grid.Row="1" Text="Logs:" VerticalAlignment="Center" Margin="0,8,0,0" />
                            <TextBox Grid.Column="1" Grid.Row="1" 
                                     Text="{Binding Settings.LogsDirectory}" 
                                     PlaceholderText="{Binding Settings.DefaultLogsDirectory}" 
                                     Height="32" VerticalContentAlignment="Center" 
                                     Margin="0,8,8,0" />
                            <Button Grid.Column="2" Grid.Row="1" Content="Browse..." 
                                    Click="BrowseLogsDirectory_Click" 
                                    Classes="Secondary" Height="32" Padding="12,0" 
                                    VerticalContentAlignment="Center" Margin="0,8,0,0" />
                        </Grid>

                        <!-- Disk Space Info on Target Drive -->
                        <Grid ColumnDefinitions="140,*" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" Text="Disk Space:" VerticalAlignment="Center" FontWeight="Medium" />
                            <StackPanel Grid.Column="1" Spacing="4">
                                <TextBlock Text="{Binding Settings.DriveStorageInfo}" FontSize="12" Foreground="#374151" TextWrapping="Wrap" />
                                <ProgressBar Minimum="0" Maximum="100" 
                                             Value="{Binding Settings.DriveUsedPercentage}" 
                                             Height="6" CornerRadius="3" 
                                             Background="#E5E7EB" Foreground="#2563EB" 
                                             IsVisible="{Binding Settings.IsDriveStorageInfoAvailable}" />
                            </StackPanel>
                        </Grid>

                        <Separator Margin="0,4" Background="#E5E7EB" />

                        <!-- Auto-Cleanup Checkbox (Responsive) -->
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Auto-Cleanup:" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.AutoCleanupSyncedLocalFiles}">
                                <TextBlock Text="Automatically clean up after database synchronization" TextWrapping="Wrap" />
                            </CheckBox>
                        </Grid>

                        <!-- Retention Window (Responsive with Width 130 and WrapPanel) -->
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Retention Window:" VerticalAlignment="Center" />
                            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <NumericUpDown Value="{Binding Settings.CleanupRetentionDays}" 
                                               Minimum="1" Maximum="365" Increment="5" 
                                               ShowButtonSpinner="True" Width="130" 
                                               Margin="0,0,10,0" />
                                <TextBlock Text="days (files older than this are eligible)" 
                                           VerticalAlignment="Center" 
                                           Foreground="#6B7280" 
                                           FontSize="11" 
                                           TextWrapping="Wrap" />
                            </WrapPanel>
                        </Grid>

                        <!-- Scope Checkbox (Responsive with TextWrapping so 'session' wraps) -->
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto">
                            <TextBlock Grid.Column="0" Text="Scope:" VerticalAlignment="Center" />
                            <CheckBox Grid.Column="1" IsChecked="{Binding Settings.CleanupOnlyWafermaps}">
                                <TextBlock Text="Only clean up Wafermaps (keep individual measurement sessions)" TextWrapping="Wrap" />
                            </CheckBox>
                        </Grid>

                        <!-- Action Button & Status Message -->
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto" Margin="0,5,0,0">
                            <Button Grid.Column="1" Content="Clean Up Local Storage Now..." 
                                    Click="CleanUpLocalStorageNowButton_Click" 
                                    Classes="Secondary" 
                                    IsEnabled="{Binding !Settings.IsCleaningUpLocalFiles}" 
                                    HorizontalAlignment="Left" />
                            <TextBlock Grid.Column="1" Grid.Row="1" 
                                       Text="{Binding Settings.CleanupStatusMessage}"
                                       Foreground="#4B5563"
                                       FontSize="12"
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Spacer -->
            <Border Height="20" />

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
                <Button Content="Reset" Click="ResetButton_Click" Classes="Secondary" Padding="15,8" />
                <Button Content="Apply" Click="ApplyButton_Click" Classes="Primary" Padding="15,8" />
            </StackPanel>

            <TextBlock Text="{Binding Settings.ApplyStatusMessage}"
                       HorizontalAlignment="Right"
                       Foreground="#2E7D32"
                       FontWeight="SemiBold" />
        </StackPanel>
    </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- Cleanup Confirmation Dialog Overlay -->
        <Grid Background="#80000000" IsVisible="{Binding Settings.IsCleanupConfirmationVisible}" ZIndex="900">
            <Border Background="White" CornerRadius="8" Padding="25" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" BorderBrush="#E5E7EB" BorderThickness="1">
                <StackPanel Spacing="16">
                    <TextBlock Text="Clean Up Local Measurements?" FontSize="18" FontWeight="Bold" Foreground="#1F2937" />
                    <TextBlock Text="{Binding Settings.CleanupConfirmationMessage}" TextWrapping="Wrap" FontSize="13" Foreground="#4B5563" />
                    <Border Background="#ECFDF5" BorderBrush="#A7F3D0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <TextBlock Text="✓ Safety Verified: Only files that are confirmed to already exist in the database will be deleted. Unsynchronized files will NEVER be touched." 
                                   TextWrapping="Wrap" FontSize="11" Foreground="#065F46" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel" Command="{Binding Settings.CancelCleanupCommand}" Classes="Secondary" Padding="14,6" />
                        <Button Content="Yes, Delete Files" Command="{Binding Settings.ConfirmCleanupCommand}" Classes="Danger" Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Centered Toast Notification -->
        <Border x:Name="ToastBorder"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="0,0,0,30"
                Background="#1E1E1E"
                CornerRadius="20"
                Padding="16,10"
                Opacity="0"
                IsVisible="False"
                ZIndex="1000">
            <Border.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25"/>
                </Transitions>
            </Border.Transitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"
                      Fill="#EF4444" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center"/>
                <TextBlock x:Name="ToastTextBlock" Foreground="White" FontSize="13" VerticalAlignment="Center" MaxWidth="300" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
